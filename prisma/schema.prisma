generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id        Int      @id @default(autoincrement())
  marque    String
  bureau    String
  prix      Float    @default(0.0)
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipmentRequests EquipmentRequest[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  user_role String
  equipmentCount Int @default(0)
  createdAt DateTime @default(now())
  equipmentRequests EquipmentRequest[]
  assignedEquipment Equipment[] @relation("AssignedEquipment")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  description String
  condition   String
  available   Boolean  @default(true)
  assignedToId Int?
  assignedTo  User?    @relation("AssignedEquipment", fields: [assignedToId], references: [id])
  requests    EquipmentRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EquipmentRequest {
  id          Int       @id @default(autoincrement())
  status      String    @default("En attente")
  createdAt   DateTime  @default(now())
  userId      Int
  equipmentId Int?
  productId   Int
  user        User      @relation(fields: [userId], references: [id])
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([equipmentId])
  @@index([productId])
}
