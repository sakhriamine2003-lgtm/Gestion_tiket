# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# SMTP email notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@example.com"
SMTP_PASSWORD="your-smtp-password"
MAIL_FROM="Gestion tickets <notifications@example.com>"
# Adresse(s) administrateur recevant les e-mails de clôture de ticket (séparées par des virgules).
# Si absent, les e-mails sont envoyés aux comptes administrateurs de la base.
ADMIN_EMAIL="admin@example.com"
